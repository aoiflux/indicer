# Pinned analysis tools for scripts/verify.ps1 and scripts/verify.sh.
# Both scripts read this file; change versions here only.
#
# staticcheck cannot read export data written by toolchains newer than the
# ones it knows, so the analysis runs under a pinned toolchain instead of the
# module's toolchain line.
STATICCHECK=honnef.co/go/tools/cmd/staticcheck@v0.8.1
GOVULNCHECK=golang.org/x/vuln/cmd/govulncheck@v1.8.0
ANALYSIS_TOOLCHAIN=go1.26.6
